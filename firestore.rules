rules_version = '2';
// blisschat v2 — production rules.
// Messages, media keys and call signalling are END-TO-END ENCRYPTED on the client; these rules only
// control WHO may store/read the (opaque) documents and protect plaintext metadata (badges, membership).
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> Put the e-mail address that owns the Super Admin account (@tomatik_dev) here <<<
    function adminEmail() { return 'CHANGE_ME@example.com'; }

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function doc(path) { return get(/databases/$(database)/documents/$(path)); }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == adminEmail()
        && request.auth.token.email_verified == true;
    }
    function isModerator() {
      return isAdmin() || (signedIn() && doc('users/' + me()).data.get('moderator', false) == true);
    }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    /* ------------------------------------------------------------- users */
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me() == uid
        && request.resource.data.verified == false && request.resource.data.support == false
        && request.resource.data.get('moderator', false) == false
        // usernames ending in _bot belong to bots (flag bot = true), and only to them
        && (request.resource.data.get('bot', false) == true) == request.resource.data.username.matches('.*_bot')
        && request.resource.data.username is string
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if (me() == uid && changed(['displayName', 'bio', 'avatarUrl', 'lastSeen', 'publicKey', 'kid', 'fcmTokens']))
        || (isAdmin() && changed(['verified', 'support', 'moderator']));
      allow delete: if false;

      // Public-key history (so old messages stay readable after a key change). Never overwritten.
      match /keys/{kid} {
        allow read: if signedIn();
        allow create: if me() == uid;
        allow update: if me() == uid && request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    /* ---------------------------------------------------------- usernames */
    // `get` is public on purpose: it lets "log in with username" find the e-mail before sign-in.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name == name.lower()
        && (name != 'blisschat_bot' || (request.auth.token.email == adminEmail() && request.auth.token.email_verified == true))
        && (name != 'tomatik_dev' || (request.auth.token.email == adminEmail() && request.auth.token.email_verified == true));
      // Taking over a v1 username: only by the account whose e-mail equals the e-mail of the old,
      // key-less v1 profile that owns the name. Reserved admin name still needs the verified admin e-mail.
      allow update: if signedIn()
        && request.resource.data.uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email'])
        && !(('kid' in doc('users/' + resource.data.uid).data) && doc('users/' + resource.data.uid).data.kid != '')
        && doc('users/' + resource.data.uid).data.email.lower() == request.auth.token.email.lower()
        && (name != 'tomatik_dev' || (request.auth.token.email == adminEmail() && request.auth.token.email_verified == true));
      allow delete: if false;
    }

    /* -------------------------------------------------------------- chats */
    match /chats/{chatId} {
      function isMember() { return signedIn() && me() in resource.data.members; }
      function isMemberAfter() { return signedIn() && me() in request.resource.data.members; }

      allow read: if isMember() || isAdmin();
      allow create: if isMemberAfter()
        && request.resource.data.ownerId == me()
        && request.resource.data.verified == false
        && (request.resource.data.type == 'GROUP' || request.resource.data.type == 'CHANNEL'
            || (request.resource.data.type == 'DIRECT' && request.resource.data.members.size() == 2));
      allow update: if (isMember() && changed(['lastEnv', 'lastMsgId', 'lastSenderId', 'lastAt', 'readers', 'members'])
          && (!('members' in request.resource.data.diff(resource.data).affectedKeys())
              || (resource.data.type in ['GROUP', 'CHANNEL']
                  && (request.resource.data.members.hasAll(resource.data.members)           // add members
                      || request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())))))   // leave
        // tag settings: only the creator
        || (signedIn() && resource.data.ownerId == me() && changed(['creatorTags', 'selfTags', 'ladder']))
        || (isAdmin() && changed(['verified']));
      allow delete: if signedIn() && ((isMember() && resource.data.ownerId == me()) || isAdmin());

      // Wrapped group keys: only the recipient (or owner/admin for cleanup) can read them.
      match /keys/{uid} {
        allow read: if signedIn() && (me() == uid || isAdmin());
        allow create: if signedIn()
          && me() in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update: if false;
        allow delete: if signedIn() && (doc('chats/' + chatId).data.ownerId == me() || isAdmin());
      }

      // Activity counters used for group tags (written by each member for themselves).
      match /stats/{uid} {
        allow read: if signedIn() && me() in doc('chats/' + chatId).data.members;
        allow create, update: if signedIn() && me() == uid && me() in doc('chats/' + chatId).data.members
          && request.resource.data.keys().hasOnly(['minutes', 'messages', 'selfTag', 'ts'])
          && (!('selfTag' in request.resource.data) || request.resource.data.selfTag.size() <= 16);
        allow delete: if signedIn() && (doc('chats/' + chatId).data.ownerId == me() || isAdmin());
      }

      match /messages/{msgId} {
        function chat() { return doc('chats/' + chatId).data; }
        allow read: if signedIn() && me() in chat().members;
        allow create: if signedIn() && me() in chat().members
          && request.resource.data.senderId == me() && request.resource.data.deleted == false
          // in a channel only the owner publishes
          && (chat().type != 'CHANNEL' || chat().ownerId == me());
        allow update: if signedIn() && me() in chat().members
          && (changed(['readBy', 'reactions'])
              || (resource.data.senderId == me() && request.resource.data.deleted == true && changed(['deleted', 'ct', 'a', 'b', 'reactions'])));
        allow delete: if signedIn() && (chat().ownerId == me() || isAdmin());
      }
    }

    /* -------------------------------------------------------------- media */
    // Encrypted photos / stickers (ciphertext only). Visible to the members of the chat they belong to.
    match /media/{id} {
      allow read: if signedIn() && me() in doc('chats/' + resource.data.chatId).data.members;
      allow create: if signedIn() && request.resource.data.by == me()
        && me() in doc('chats/' + request.resource.data.chatId).data.members;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.by == me()
        || doc('chats/' + resource.data.chatId).data.ownerId == me() || isAdmin());
    }

    /* ------------------------------------------------------------ plugins */
    // Plugins are data-only .zip files. New ones are "pending" until a moderator (appointed by the admin) approves them.
    match /plugins/{id} {
      allow read: if signedIn() && (resource.data.status == 'approved' || resource.data.authorId == me() || isModerator());
      allow create: if signedIn() && request.resource.data.authorId == me() && request.resource.data.status == 'pending';
      allow update: if isModerator() && changed(['status', 'reviewedBy', 'note']);
      allow delete: if signedIn() && (resource.data.authorId == me() || isModerator());
    }
    match /pluginFiles/{id} {
      allow read: if signedIn() && (resource.data.authorId == me() || isModerator()
        || doc('plugins/' + id).data.status == 'approved');
      allow create: if signedIn() && request.resource.data.authorId == me();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == me() || isModerator());
    }

    /* -------------------------------------------------------------- calls */
    match /calls/{callId} {
      allow read: if signedIn() && (me() == resource.data.callerId || me() == resource.data.calleeId);
      // incoming-call listener: query by calleeId == me
      allow create: if signedIn() && request.resource.data.callerId == me() && request.resource.data.status == 'ringing';
      allow update: if signedIn() && (me() == resource.data.callerId || me() == resource.data.calleeId)
        && changed(['status', 'answer']);
      allow delete: if false;

      match /cands/{candId} {
        function call() { return doc('calls/' + callId).data; }
        allow read: if signedIn() && (me() == call().callerId || me() == call().calleeId);
        allow create: if signedIn() && request.resource.data.from == me() && (me() == call().callerId || me() == call().calleeId);
        allow update, delete: if false;
      }
    }

    /* ------------------------------------------------------------ reports */
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == me();
      allow read, update, delete: if false;
    }
  }
}
